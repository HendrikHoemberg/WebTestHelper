# Copy to .env and fill in.
# WTH_DB_PASSWORD is required; all other values are optional (blank ones are skipped).
# If WTH_ADMIN_PASSWORD is blank, a password is generated and logged on first start.

WTH_DB_PASSWORD=
WTH_ADMIN_PASSWORD=
WTH_BASE_URL=http://localhost:8080

WTH_SMTP_HOST=
WTH_SMTP_PORT=
WTH_SMTP_TLS=
WTH_SMTP_USER=
WTH_SMTP_PASSWORD=
WTH_SMTP_FROM=

WTH_IMAP_HOST=
WTH_IMAP_PORT=
WTH_IMAP_TLS=
WTH_IMAP_USER=
WTH_IMAP_PASSWORD=
WTH_IMAP_FOLDER=
WTH_IMAP_ADDRESS=
