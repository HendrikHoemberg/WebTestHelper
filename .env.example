# Copy to .env and fill in. All values optional; blank ones are skipped.
# If WTH_ADMIN_PASSWORD is blank, a password is generated and logged on first start.

WTH_ADMIN_PASSWORD=
WTH_BASE_URL=http://localhost:8080

WTH_SMTP_HOST=
WTH_SMTP_PORT=
WTH_SMTP_TLS=
WTH_SMTP_USER=
WTH_SMTP_PASSWORD=
WTH_SMTP_FROM=
